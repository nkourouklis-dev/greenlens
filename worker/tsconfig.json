{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["index.ts", "ocr.ts", "analysis.ts", "cors.ts", "scoring.ts", "ingredientKnowledge.ts", "ingredientInsights.ts", "worker-configuration.d.ts"]
}